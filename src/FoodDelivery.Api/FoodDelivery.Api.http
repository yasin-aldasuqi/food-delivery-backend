@host = http://localhost:5127

### List restaurants (paged)
GET {{host}}/api/restaurants?page=1&pageSize=20
Accept: application/json

### Get one restaurant
GET {{host}}/api/restaurants/1

### Create a restaurant (OwnerId must be an existing user — temporary until auth)
POST {{host}}/api/restaurants
Content-Type: application/json

{
  "name": "Shawarma House",
  "description": "Chicken and beef shawarma",
  "address": "King Fahd Rd, Riyadh",
  "phoneNumber": "+966500000000",
  "ownerId": 1
}

### Update a restaurant
PUT {{host}}/api/restaurants/1
Content-Type: application/json

{
  "name": "Shawarma House",
  "address": "King Fahd Rd, Riyadh",
  "isActive": true
}

### Validation error example (empty name → 400)
POST {{host}}/api/restaurants
Content-Type: application/json

{ "name": "", "address": "x", "ownerId": 1 }

### List a restaurant's menu
GET {{host}}/api/restaurants/1/menu-items

### Add a menu item
POST {{host}}/api/restaurants/1/menu-items
Content-Type: application/json

{
  "name": "Chicken Shawarma",
  "price": 15.50,
  "category": "Sandwiches"
}

### Delete a menu item
DELETE {{host}}/api/restaurants/1/menu-items/1
