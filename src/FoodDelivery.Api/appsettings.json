{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FoodDelivery.Api",
    "Audience": "FoodDelivery.Clients",
    "ExpiryMinutes": 60
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 3600
    }
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "DurationMinutes": 15
  }
}
